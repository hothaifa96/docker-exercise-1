
# --- MySQL Container ---
MYSQL_ROOT_PASSWORD=???         # Root password for MySQL
MYSQL_DATABASE=???              # Database name to create
MYSQL_USER=???                  # App database user
MYSQL_PASSWORD=???              # App database user password

# --- Backend (Flask) Container ---
DB_HOST=???                     # Hostname of the MySQL container
DB_PORT=3306
DB_NAME=???                     # Must match MYSQL_DATABASE above
DB_USER=???                     # Must match MYSQL_USER above
DB_PASSWORD=???                 # Must match MYSQL_PASSWORD above

# --- Frontend (React) Container ---
REACT_APP_API_URL=???           # Full URL to the backend API (e.g. http://localhost:5000)
